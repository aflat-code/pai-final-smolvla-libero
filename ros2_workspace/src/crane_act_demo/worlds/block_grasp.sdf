<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional"><pose>0 0 4 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.2 -1</direction><cast_shadows>true</cast_shadows></light>
    <model name="table"><static>true</static><pose>0.20 0 0.99 0 0 0</pose><link name="table_link">
      <collision name="table_collision"><geometry><box><size>0.8 0.8 0.05</size></box></geometry></collision>
      <visual name="table_visual"><geometry><box><size>0.8 0.8 0.05</size></box></geometry><material><ambient>0.30 0.24 0.17 1</ambient><diffuse>0.55 0.43 0.28 1</diffuse></material></visual>
    </link></model>
    <model name="red_block"><pose>0.13 0.020 1.031 0 0 0</pose><link name="block_link">
      <inertial><mass>0.008</mass><inertia><ixx>0.0000012</ixx><iyy>0.0000012</iyy><izz>0.0000012</izz></inertia></inertial>
      <collision name="block_collision"><geometry><box><size>0.03 0.03 0.03</size></box></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <visual name="block_visual"><geometry><box><size>0.03 0.03 0.03</size></box></geometry><material><ambient>0.85 0.015 0.015 1</ambient><diffuse>0.95 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name="blue_goal"><static>true</static><pose>0.112 -0.070 1.0152 0 0 0</pose><link name="goal_link">
      <visual name="goal_visual"><geometry><box><size>0.09 0.10 0.0004</size></box></geometry><material><ambient>0.015 0.15 0.85 1</ambient><diffuse>0.03 0.25 1 1</diffuse></material></visual>
    </link></model>
    <model name="camera_rig"><static>true</static><pose>0.65 -0.65 1.50 0 0.40 2.18</pose><link name="camera_link">
      <sensor name="crane_camera" type="camera"><always_on>true</always_on><update_rate>15</update_rate><topic>/crane_camera</topic><camera><horizontal_fov>1.02</horizontal_fov><image><width>960</width><height>540</height><format>R8G8B8</format></image><clip><near>0.05</near><far>10</far></clip></camera></sensor>
    </link></model>
  </world>
</sdf>
