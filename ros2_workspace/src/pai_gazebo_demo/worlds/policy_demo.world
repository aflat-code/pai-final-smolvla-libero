<?xml version="1.0"?>
<sdf version="1.6">
  <world name="policy_demo">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <physics type="ode"><real_time_update_rate>100</real_time_update_rate><max_step_size>0.01</max_step_size></physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="robot">
      <pose>-0.7 -0.7 0.16 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>2.0</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz></inertia></inertial>
        <collision name="body_collision"><geometry><cylinder><radius>0.20</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="body_visual"><geometry><cylinder><radius>0.20</radius><length>0.16</length></cylinder></geometry><material><ambient>0.03 0.30 0.85 1</ambient><diffuse>0.03 0.30 0.85 1</diffuse></material></visual>
        <visual name="direction"><pose>0.16 0 0.11 0 0 0</pose><geometry><box><size>0.18 0.08 0.08</size></box></geometry><material><ambient>1 0.35 0.03 1</ambient><diffuse>1 0.35 0.03 1</diffuse></material></visual>
      </link>
      <link name="left_wheel"><pose>0 0.22 0 1.5708 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient></material></visual></link>
      <link name="right_wheel"><pose>0 -0.22 0 1.5708 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient></material></visual></link>
      <joint name="left_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="right_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros><namespace>/</namespace></ros><update_rate>50</update_rate><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>0.44</wheel_separation><wheel_diameter>0.16</wheel_diameter><max_wheel_torque>10</max_wheel_torque><command_topic>cmd_vel</command_topic><odometry_topic>odom</odometry_topic><odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame><publish_odom>true</publish_odom>
      </plugin>
    </model>

    <model name="camera_rig">
      <static>true</static><pose>0 0 5.8 0 1.5708 0</pose>
      <link name="camera_link"><sensor name="demo_camera" type="camera"><always_on>true</always_on><update_rate>10</update_rate><camera><horizontal_fov>0.95</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><plugin name="camera_controller" filename="libgazebo_ros_camera.so"><ros><namespace>/demo_camera</namespace></ros><camera_name>demo_camera</camera_name><frame_name>camera_link</frame_name></plugin></sensor></link>
    </model>

    <model name="target_1"><static>true</static><pose>-0.7 0.65 0.015 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual></link></model>
    <model name="target_2"><static>true</static><pose>0.65 0.65 0.015 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual></link></model>
    <model name="target_3"><static>true</static><pose>0.65 -0.7 0.015 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual></link></model>
  </world>
</sdf>
